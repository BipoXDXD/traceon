{
  "openapi": "3.1.1",
  "info": {
    "title": "Traceon API",
    "description": "API do Traceon, SaaS de monitoramento de integridade de aplicações web. Na etapa Foundation expõe apenas os endpoints de saúde (liveness e readiness), sem autenticação e sem dados de negócio.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Mesma origem do frontend"
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Verifica se o processo da API está vivo",
        "description": "Não executa nenhuma verificação de dependência: uma falha do banco de dados não deve levar o orquestrador a reiniciar um processo saudável. Responde 200 enquanto o processo atende. Sem autenticação, para o orquestrador e o proxy; por isso o corpo é mínimo e não expõe diagnóstico (descrição, exceção, duração, host ou porta).",
        "operationId": "getLiveness",
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "description": "Sempre no-store: o estado de saúde muda a cada chamada e não pode ser reaproveitado.",
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Verifica se a API está pronta para receber tráfego",
        "description": "Executa as verificações de prontidão; hoje, abre uma conexão real com o banco de dados, limitada a 3 segundos. Responde 200 quando todas estão Healthy ou Degraded e 503 quando alguma está Unhealthy. Sem autenticação; o corpo traz só o status geral e, por verificação, nome e status, sem diagnóstico (descrição, exceção, duração, host, porta ou connection string).",
        "operationId": "getReadiness",
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "description": "Sempre no-store: o estado de saúde muda a cada chamada e não pode ser reaproveitado.",
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "headers": {
              "Cache-Control": {
                "description": "Sempre no-store: o estado de saúde muda a cada chamada e não pode ser reaproveitado.",
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckResponse": {
        "required": [
          "name",
          "status"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        }
      },
      "HealthStatus": {
        "enum": [
          "Unhealthy",
          "Degraded",
          "Healthy"
        ]
      },
      "LivenessResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ReadinessResponse": {
        "required": [
          "status",
          "checks"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "checks": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CheckResponse"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Health"
    }
  ]
}