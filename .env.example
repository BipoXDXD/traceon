# Copie para .env e troque os valores. O arquivo .env é ignorado pelo Git.
# Usado pelo Docker Compose (compose.yaml) e pela API (o README carrega este arquivo no shell antes de subi-la).
POSTGRES_DB=traceon
POSTGRES_USER=traceon
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# A API lê o banco destas três variáveis; sem URL válida ela não sobe. Derivadas das de cima, para não divergirem.
# Em outros ambientes, defina-as direto no ambiente do processo (nunca num arquivo versionado).
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}
