root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets,slnx}]
indent_size = 2

# Java segue o Palantir Java Format (Spotless); o POM acompanha a indentação
[{*.java,pom.xml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Organização
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning

# Estilo
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# Nomes (.NET design guidelines)
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# Constantes seguem a guideline oficial (PascalCase); regra mais específica que a de campos privados.
dotnet_naming_rule.private_constants_pascal.severity = warning
dotnet_naming_rule.private_constants_pascal.symbols = private_constants
dotnet_naming_rule.private_constants_pascal.style = pascal_case
dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_symbols.private_constants.applicable_accessibilities = private
dotnet_naming_symbols.private_constants.required_modifiers = const
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.async_methods_suffix.severity = warning
dotnet_naming_rule.async_methods_suffix.symbols = async_methods
dotnet_naming_rule.async_methods_suffix.style = async_suffix
dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.async_suffix.capitalization = pascal_case
dotnet_naming_style.async_suffix.required_suffix = Async

# Analyzers
dotnet_diagnostic.CA2007.severity = none # ASP.NET Core não tem SynchronizationContext; ConfigureAwait(false) seria ruído
dotnet_diagnostic.CS4014.severity = error

[**/tests/**.cs]
# xUnit: nomes de teste descritivos com underscore.
dotnet_diagnostic.CA1707.severity = none
# O nome do teste descreve o comportamento; o sufixo Async não acrescenta nada a quem lê o relatório.
dotnet_naming_rule.async_methods_suffix.severity = none
