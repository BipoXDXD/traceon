{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "API do Traceon, SaaS de monitoramento de integridade de aplicações web. Na etapa Foundation expõe apenas os endpoints de saúde (liveness e readiness), sem autenticação e sem dados de negócio.",
    "title" : "Traceon API",
    "version" : "1.0.0"
  },
  "servers" : [ {
    "url" : "/",
    "description" : "Mesma origem do frontend"
  } ],
  "tags" : [ {
    "description" : "Estado do processo da API e das dependências dele",
    "name" : "Health"
  } ],
  "paths" : {
    "/health/live" : {
      "get" : {
        "description" : "Não executa nenhuma verificação de dependência: uma falha do banco de dados não deve levar o orquestrador a reiniciar um processo saudável. Responde 200 enquanto o processo atende. Sem autenticação, para o orquestrador e o proxy; por isso o corpo é mínimo e não expõe diagnóstico (descrição, exceção, duração, host ou porta).",
        "operationId" : "getLiveness",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description" : "OK",
            "headers" : {
              "Cache-Control" : {
                "description" : "Sempre no-store: o estado de saúde muda a cada chamada e não pode ser reaproveitado.",
                "schema" : {
                  "type" : "string",
                  "enum" : [ "no-store" ]
                }
              }
            }
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Internal Server Error"
          }
        },
        "summary" : "Verifica se o processo da API está vivo",
        "tags" : [ "Health" ]
      }
    },
    "/health/ready" : {
      "get" : {
        "description" : "Executa as verificações de prontidão; hoje, abre uma conexão real com o banco de dados, limitada a 3 segundos. Responde 200 quando todas estão Healthy ou Degraded e 503 quando alguma está Unhealthy. Sem autenticação; o corpo traz só o status geral e, por verificação, nome e status, sem diagnóstico (descrição, exceção, duração, host, porta ou connection string).",
        "operationId" : "getReadiness",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description" : "OK",
            "headers" : {
              "Cache-Control" : {
                "description" : "Sempre no-store: o estado de saúde muda a cada chamada e não pode ser reaproveitado.",
                "schema" : {
                  "type" : "string",
                  "enum" : [ "no-store" ]
                }
              }
            }
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Internal Server Error"
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description" : "Service Unavailable",
            "headers" : {
              "Cache-Control" : {
                "description" : "Sempre no-store: o estado de saúde muda a cada chamada e não pode ser reaproveitado.",
                "schema" : {
                  "type" : "string",
                  "enum" : [ "no-store" ]
                }
              }
            }
          }
        },
        "summary" : "Verifica se a API está pronta para receber tráfego",
        "tags" : [ "Health" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "CheckResponse" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 64,
            "pattern" : "^[a-z][a-z0-9-]*$"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "Unhealthy", "Degraded", "Healthy" ]
          }
        },
        "required" : [ "name", "status" ]
      },
      "LivenessResponse" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string",
            "enum" : [ "Unhealthy", "Degraded", "Healthy" ]
          }
        },
        "required" : [ "status" ]
      },
      "ProblemDetail" : {
        "type" : "object",
        "description" : "Erro no formato RFC 9457. Sem stack trace, SQL nem nome de classe.",
        "properties" : {
          "detail" : {
            "type" : "string",
            "maxLength" : 1000
          },
          "instance" : {
            "type" : "string",
            "format" : "uri-reference",
            "maxLength" : 1000
          },
          "status" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 599,
            "minimum" : 100
          },
          "title" : {
            "type" : "string",
            "maxLength" : 1000
          },
          "traceId" : {
            "type" : "string",
            "description" : "Trace id W3C da requisição; vem no 500 e é o mesmo do log do erro",
            "maxLength" : 32,
            "minLength" : 32,
            "pattern" : "^[0-9a-f]{32}$"
          },
          "type" : {
            "type" : "string",
            "format" : "uri-reference",
            "maxLength" : 1000
          }
        },
        "required" : [ "status", "title" ]
      },
      "ReadinessResponse" : {
        "type" : "object",
        "properties" : {
          "checks" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/CheckResponse"
            },
            "maxItems" : 16
          },
          "status" : {
            "type" : "string",
            "enum" : [ "Unhealthy", "Degraded", "Healthy" ]
          }
        },
        "required" : [ "checks", "status" ]
      }
    }
  }
}