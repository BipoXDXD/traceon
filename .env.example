# Copie para .env e troque os valores. O arquivo .env é ignorado pelo Git.
# Usado pelo Docker Compose (compose.yaml).
POSTGRES_DB=traceon
POSTGRES_USER=traceon
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# A API lê a connection string da chave ConnectionStrings:Traceon.
# Em desenvolvimento, prefira User Secrets (veja o README):
#   dotnet user-secrets set "ConnectionStrings:Traceon" "Host=localhost;Port=5432;Database=traceon;Username=traceon;Password=troque-esta-senha" --project backend/src/Traceon.Api
# Em outros ambientes, use a variável de ambiente abaixo (dois underscores separam as seções):
# ConnectionStrings__Traceon=Host=localhost;Port=5432;Database=traceon;Username=traceon;Password=troque-esta-senha
