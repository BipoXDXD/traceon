root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java segue o Palantir Java Format (Spotless); o POM acompanha a indentação
[{*.java,pom.xml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
